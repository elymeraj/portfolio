 (!experience || experience.length === 0) return null\n\n  return (\n    <section className='section experience' id='experience'>\n      <h2 className='section__title'>Experience</h2>\n\n      <div className='experience__grid'>\n        {experience.map((exp) => (\n          <div key={exp.id} className='experience__card'>\n            <h3>{exp.title}</h3>\n            <p>\n              <strong>{exp.company}</strong> · {exp.period}\n            </p>\n\n            {exp.description && <p>{exp.description}</p>}\n\n            {exp.responsibilities?.length > 0 && (\n              <>\n                <h4>Key responsibilities</h4>\n                <ul className='experience__list'>\n                  {exp.responsibilities.map((r) => (\n                    <li key={`${exp.id}-${r}`}>{r}</li>\n                  ))}\n                </ul>\n              </>\n            )}\n\n            {exp.stack?.length > 0 && (\n              <p className='experience__stack'>\n                <strong>Stack:</strong> {exp.stack.join(' · ')}\n              </p>\n            )}\n          </div>\n        ))}\n      </div>\n    </section>\n  )\n}\n\nexport default Experience\n"],"mappings":"AAAA,MAAO,kBAAkB,CACzB,OAASA,UAAU,KAAQ,iBAAiB,QAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,CAAAC,QAAA,IAAAC,SAAA,yBAE5C,KAAM,CAAAC,UAAU,CAAGA,CAAA,GAAM,CACvB,GAAI,CAACP,UAAU,EAAIA,UAAU,CAACQ,MAAM,GAAK,CAAC,CAAE,MAAO,KAAI,CAEvD,mBACEJ,KAAA,YAASK,SAAS,CAAC,oBAAoB,CAACC,EAAE,CAAC,YAAY,CAAAC,QAAA,eACrDT,IAAA,OAAIO,SAAS,CAAC,gBAAgB,CAAAE,QAAA,CAAC,YAAU,CAAI,CAAC,cAE9CT,IAAA,QAAKO,SAAS,CAAC,kBAAkB,CAAAE,QAAA,CAC9BX,UAAU,CAACY,GAAG,CAAEC,GAAG,OAAAC,qBAAA,CAAAC,UAAA,oBAClBX,KAAA,QAAkBK,SAAS,CAAC,kBAAkB,CAAAE,QAAA,eAC5CT,IAAA,OAAAS,QAAA,CAAKE,GAAG,CAACG,KAAK,CAAK,CAAC,cACpBZ,KAAA,MAAAO,QAAA,eACET,IAAA,WAAAS,QAAA,CAASE,GAAG,CAACI,OAAO,CAAS,CAAC,SAAG,CAACJ,GAAG,CAACK,MAAM,EAC3C,CAAC,CAEHL,GAAG,CAACM,WAAW,eAAIjB,IAAA,MAAAS,QAAA,CAAIE,GAAG,CAACM,WAAW,CAAI,CAAC,CAE3C,EAAAL,qBAAA,CAAAD,GAAG,CAACO,gBAAgB,UAAAN,qBAAA,iBAApB